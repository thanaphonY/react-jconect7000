// JConnect TimescaleDB / PostgreSQL public schema
// Relationships come from declared foreign keys.

Table "alarm_log_dispatch" {
  "id" "integer" [not null, default: `nextval('alarm_log_dispatch_id_seq'::regclass)`]
  "alarm_log_id" "integer" [not null]
  "channel_id" "integer" [not null]
  "status" "character varying(20)" [not null, default: `'queued'::character varying`]
  "error" "text"
  "sent_at" "timestamp without time zone"
  "created_at" "timestamp without time zone" [default: `CURRENT_TIMESTAMP`]
}

Table "alarm_logs" {
  "id" "integer" [not null, default: `nextval('alarm_logs_id_seq'::regclass)`]
  "device_id" "integer" [not null]
  "metric_key" "text" [not null]
  "message" "text"
  "severity" "text"
  "channel" "text"
  "status" "text" [default: `'queued'::text`]
  "error" "text"
  "sent_at" "timestamp without time zone"
  "created_at" "timestamp with time zone" [default: `CURRENT_TIMESTAMP`]
  "trigger_type" "character varying(20)"
  "channels" "text"
  "duration_minutes" "integer"
  "trigger_id" "text"
  "value" "text"
  "snapshot_path" "text"
  "snapshot_camera_device_id" "text"
}

Table "alarm_state" {
  "device_id" "integer" [not null]
  "metric_key" "text" [not null]
  "active" "boolean" [default: `false`]
  "last_triggered" "timestamp with time zone"
  "last_cleared" "timestamp with time zone"
  "message" "text"
  "severity" "text"
  "acknowledged" "boolean" [default: `false`]
  "acknowledged_by" "text"
  "acknowledged_at" "timestamp without time zone"
  "acknowledge_note" "text"
  "trigger_id" "text" [not null]

  indexes {
    ("device_id", "metric_key", "trigger_id") [pk, name: 'alarm_state_pkey']
  }
}

