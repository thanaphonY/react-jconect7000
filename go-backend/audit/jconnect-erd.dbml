Ref: "api_client_scopes"."api_client_id" > "api_clients"."id" [delete: cascade, update: no action]
Ref: "api_request_counts"."api_client_id" > "api_clients"."id" [delete: cascade, update: no action]
Ref: "api_request_logs"."api_client_id" > "api_clients"."id" [delete: set null, update: no action]
Ref: "device_maintenance"."created_by" > "ia_users"."ia_users_id" [delete: no action, update: no action]
Ref: "device_maintenance"."device_id" > "devices"."id" [delete: cascade, update: no action]
Ref: "device_templates"."category_id" > "device_categories"."id" [delete: no action, update: no action]
Ref: "devices"."category_id" > "device_categories"."id" [delete: no action, update: no action]
Ref: "devices"."created_by" > "ia_users"."ia_users_id" [delete: no action, update: no action]
Ref: "devices"."device_template_id" > "device_templates"."id" [delete: cascade, update: no action]
Ref: "devices"."site_node_id" > "site_nodes"."id" [delete: set null, update: no action]
Ref: "health_check_logs"."health_check_id" > "health_checks"."id" [delete: cascade, update: no action]
