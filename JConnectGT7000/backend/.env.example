# URL-encode special characters in the password. @ is %40.
PORT=4000
DATABASE_URL=postgresql://jconnect:changeme@127.0.0.1:5432/jconnect
AUTH_SECRET=replace-with-a-long-random-string
# Same ChirpStack REST proxy PHP uses (nginx /loraapi/rest → :8090).
CHIRPSTACK_BASE_URL=http://127.0.0.1/loraapi/rest/api
# Optional; defaults to the API key already configured in PHP config.php.
# CHIRPSTACK_API_KEY=Bearer <token>

